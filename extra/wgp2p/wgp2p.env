# Единственный источник правды для всех скриптов комплекта wgp2p.
# При переносе на другой сервер правится только ENDPOINT_HOST (и WG_PORT,
# если на новом хосте порт занят). Всё остальное трогать не нужно.

# Имя интерфейса. Оно же имя файла конфига и имя systemd-юнита wg-quick@<IFACE>.
IFACE=wgp2p

# UDP-порт хаба. 51820 на этом сервере занят контейнером wg-easy, поэтому 51830.
# Если провайдер фильтрует нестандартные UDP-порты (проверяется первым же
# хендшейком), меняй здесь и перезапускай install.sh — клиентам придётся
# поправить Endpoint.
WG_PORT=51830

# Подсеть /24 без последнего октета. Выбрана так, чтобы не пересекаться:
#   VPN (openconnect) занимает 10.43/16, 10.45/16, 100.64.1.0/24, 192.168.241/24
#   домашняя LAN                        192.168.0.0/24
#   VR-точка доступа на десктопе        10.42.0.0/24
#   docker-мосты                        172.17.0.0/16 ... 172.24.0.0/16
#   wg-easy и OpenVPN на этом сервере   10.8.0.0/24
# Пересечение сломало бы либо доступ, либо локальные сервисы.
SUBNET=10.66.66

# Публичный адрес этого сервера — попадает в Endpoint клиентских конфигов.
ENDPOINT_HOST=185.196.117.103

# MTU туннеля. Не дефолтные 1420, а 1360: клиент может оказаться в сети, где
# Endpoint попадает внутрь тоннеля openconnect (tun0 MTU 1422). Тогда
# WG-пакет должен влезть в 1422 с учётом оверхеда IP+UDP+WireGuard (60 байт):
# 1422 - 60 = 1362, берём 1360 с запасом. На обычном ethernet (1500) это стоит
# ~4% пропускной способности — для ssh, портов и rsync незаметно, зато нет
# чёрных дыр PMTU в экзотических сетях.
MTU=1360

# Адрес хаба внутри туннеля — первый адрес подсети. Клиентам выдаются .2, .3, ...
SERVER_IP=${SUBNET}.1
