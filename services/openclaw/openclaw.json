{
  "gateway": {
    "mode": "local",
    "bind": "lan",
    "auth": {
      "mode": "token",
      "rateLimit": {
        "maxAttempts": 10,
        "windowMs": 60000,
        "lockoutMs": 300000
      }
    },
    "controlUi": {
      "allowedOrigins": [
        "http://127.0.0.1:18789",
        "http://localhost:18789",
        "http://192.168.0.107:18789",
        "http://10.66.66.2:18789"
      ]
    }
  },
  "agents": {
    "defaults": {
      "workspace": "/workspace",
      "model": {
        "primary": "lmstudio/qwen35"
      },
      "modelPolicy": {
        "allow": [
          "lmstudio/qwen35",
          "lmstudio/nvidia/nemotron-3-nano-4b",
          "lmstudio/google/gemma-3-4b",
          "lmstudio/prism-ml/bonsai-27b",
          "lmstudio/google/gemma-4-12b-qat",
          "lmstudio/gemma4",
          "lmstudio/openai/gpt-oss-20b",
          "lmstudio/mistralai/devstral-small-2-2512",
          "lmstudio/qwen/qwen3.6-27b",
          "lmstudio/nvidia/nemotron-3-nano-omni",
          "lmstudio/google/gemma-4-31b",
          "lmstudio/zai-org/glm-4.7-flash",
          "lmstudio/google/gemma-4-26b-a4b",
          "lmstudio/qwen/qwen3.6-35b-a3b",
          "lmstudio/google/gemma-4-e4b",
          "openai/gpt-6-astra"
        ]
      },
      "models": {
        "lmstudio/qwen35": {
          "alias": "Qwen Local"
        },
        "openai/gpt-6-astra": {
          "alias": "Codex",
          "agentRuntime": {
            "id": "openclaw"
          }
        }
      }
    }
  },
  "models": {
    "mode": "merge",
    "providers": {
      "lmstudio": {
        "baseUrl": "http://host.docker.internal:1234/v1",
        "apiKey": "${LM_API_TOKEN}",
        "api": "openai-completions",
        "timeoutSeconds": 300,
        "params": {
          "preload": false
        },
        "models": [
          {
            "id": "qwen35",
            "name": "Qwen3.5 9B Uncensored HauhauCS Aggressive",
            "reasoning": false,
            "input": ["text"],
            "cost": {
              "input": 0,
              "output": 0,
              "cacheRead": 0,
              "cacheWrite": 0
            },
            "contextWindow": 262144,
            "contextTokens": 131072,
            "maxTokens": 8192
          },
          {
            "id": "nvidia/nemotron-3-nano-4b",
            "name": "Nemotron 3 Nano 4B",
            "contextTokens": 131072
          },
          {
            "id": "google/gemma-3-4b",
            "name": "Gemma 3 4B",
            "contextTokens": 131072
          },
          {
            "id": "prism-ml/bonsai-27b",
            "name": "Bonsai 27B",
            "contextTokens": 131072
          },
          {
            "id": "google/gemma-4-12b-qat",
            "name": "Gemma 4 12B QAT",
            "contextTokens": 131072
          },
          {
            "id": "gemma4",
            "name": "Gemma 4 E4B Instruct OBLITERATED",
            "contextTokens": 131072
          },
          {
            "id": "openai/gpt-oss-20b",
            "name": "GPT-OSS 20B",
            "contextTokens": 131072
          },
          {
            "id": "mistralai/devstral-small-2-2512",
            "name": "Devstral Small 2 2512",
            "contextTokens": 131072
          },
          {
            "id": "qwen/qwen3.6-27b",
            "name": "Qwen3.6 27B",
            "contextTokens": 131072
          },
          {
            "id": "nvidia/nemotron-3-nano-omni",
            "name": "Nemotron 3 Nano Omni",
            "contextTokens": 131072
          },
          {
            "id": "google/gemma-4-31b",
            "name": "Gemma 4 31B",
            "contextTokens": 131072
          },
          {
            "id": "zai-org/glm-4.7-flash",
            "name": "GLM 4.7 Flash",
            "contextTokens": 131072
          },
          {
            "id": "google/gemma-4-26b-a4b",
            "name": "Gemma 4 26B A4B",
            "contextTokens": 131072
          },
          {
            "id": "qwen/qwen3.6-35b-a3b",
            "name": "Qwen3.6 35B A3B",
            "contextTokens": 131072
          },
          {
            "id": "google/gemma-4-e4b",
            "name": "Gemma 4 E4B",
            "contextTokens": 131072
          }
        ]
      }
    }
  },
  "memory": {
    "search": {
      "provider": "lmstudio",
      "model": "text-embedding-nomic-embed-text-v1.5@q4_k_m",
      "fallback": "none"
    }
  },
  "tools": {
    "profile": "minimal",
    "alsoAllow": ["group:fs", "group:memory"],
    "deny": [
      "group:runtime",
      "group:web",
      "group:ui",
      "group:automation",
      "group:messaging",
      "group:sessions",
      "group:nodes",
      "group:agents",
      "group:plugins"
    ],
    "fs": {
      "workspaceOnly": true
    },
    "elevated": {
      "enabled": false
    }
  },
  "plugins": {
    "allow": ["memory-core", "lmstudio", "openai"],
    "entries": {
      "github": {
        "enabled": false
      }
    }
  },
  "skills": {
    "allowBundled": []
  }
}
